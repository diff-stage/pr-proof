{
    "name": "diff-stage/recorder",
    "description": "Readable videos of Pest browser tests, posted on your pull requests.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "pestphp/pest": "^4.0 || ^5.2.1",
        "pestphp/pest-plugin-browser": "4.3.1 || 5.1.2"
    },
    "autoload": {
        "psr-4": {
            "DiffStage\\Recorder\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "bin": [
        "bin/diff-stage-compress"
    ],
    "extra": {
        "pest": {
            "plugins": [
                "DiffStage\\Recorder\\Plugin"
            ]
        }
    },
    "minimum-stability": "stable"
}
